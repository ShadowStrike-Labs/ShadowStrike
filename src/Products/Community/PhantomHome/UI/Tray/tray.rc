/*
 * ShadowStrike - Enterprise NGAV/EDR Platform
 * Copyright (C) 2026 ShadowStrike Security
 *
 * tray.rc — Win32 resource script for ShadowStrikePhantomTray.exe.
 *
 * Icon resources: Tray icon files are generated by the packaging pipeline
 * from src\Products\Community\PhantomHome\UI\Tray\assets\tray_logo.png.
 *
 * TODO(packaging): Run the following (requires ImageMagick) to generate
 *   the multi-resolution .ico files before a release build:
 *
 *   magick convert tray_logo.png ^
 *       -define icon:auto-resize=256,128,64,32,16 ^
 *       assets\tray_healthy.ico
 *
 *   Repeat for tray_atrisk.ico, tray_critical.ico, tray_paused.ico,
 *   tray_offline.ico (apply appropriate tint/overlay per state).
 *
 *   Until the .ico files are present this resource script is excluded from
 *   the build (ExcludedFromBuild in ShadowStrikePhantomTray.vcxproj).
 *   The tray falls back to IDI_SHIELD at runtime when resources are absent.
 */

#include "TrayIconIds.hpp"

IDI_TRAY_HEALTHY   ICON "assets\\tray_healthy.ico"
IDI_TRAY_ATRISK    ICON "assets\\tray_atrisk.ico"
IDI_TRAY_CRITICAL  ICON "assets\\tray_critical.ico"
IDI_TRAY_PAUSED    ICON "assets\\tray_paused.ico"
IDI_TRAY_OFFLINE   ICON "assets\\tray_offline.ico"
