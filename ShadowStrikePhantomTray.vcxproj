<?xml version="1.0" encoding="utf-8"?>
<!--
  ShadowStrikePhantomTray.vcxproj
  ===============================
  Lightweight system-tray companion. Separate from the Qt UI so that the
  tray icon remains live even when the heavier UI window is closed.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{C3D49032-8B5E-4C2C-90A3-1B2C5D6E7F03}</ProjectGuid>
    <RootNamespace>ShadowStrikePhantomTray</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <IntDir>$(ProjectDir)build\$(Configuration)\Tray\</IntDir>
    <OutDir>$(SolutionDir)bin\$(Configuration)\</OutDir>
    <TargetName>ShadowStrikePhantomTray</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- stdcpp23 to match PhantomCoreLib, which this project both LINKS
           (PhantomCoreLib.lib below) and whose headers it COMPILES. Two language
           modes over one set of shared declarations is the divergent-view hazard
           that produced the ODR heap corruption in task 73; the C++ standard gives
           no guarantee that project headers present an identical layout under
           /std:c++20 and /std:c++23. No specific diverging type was identified
           here - the point is that nothing rules one out, and parity costs a line. -->
      <LanguageStandard>stdcpp23</LanguageStandard>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalOptions>/utf-8 /Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
      <WarningLevel>Level4</WarningLevel>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalIncludeDirectories>$(SolutionDir)include;$(SolutionDir)include\YARA;$(SolutionDir)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;UNICODE;_UNICODE;NOMINMAX;WIN32_LEAN_AND_MEAN;SHADOWSTRIKE_PRODUCT_HOME=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EntryPointSymbol>wWinMainCRTStartup</EntryPointSymbol>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>PhantomCoreLib.lib;libcrypto.lib;libssl.lib;shell32.lib;user32.lib;gdi32.lib;advapi32.lib;ws2_32.lib;crypt32.lib;iphlpapi.lib;ole32.lib;oleaut32.lib;dwmapi.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(SolutionDir)lib\$(Configuration);$(SolutionDir)vendor;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="src\Products\Community\PhantomHome\UI\Tray\main.cpp" />
    <ClCompile Include="src\Products\Community\PhantomHome\UI\Tray\TrayApp.cpp" />
    <ClCompile Include="src\Products\Community\PhantomHome\UI\Tray\TrayMenu.cpp" />
    <ClCompile Include="src\Products\Community\PhantomHome\UI\Tray\AutoRun.cpp" />
    <ClCompile Include="src\Products\Community\PhantomHome\UI\Tray\InstallProbe.cpp" />
    <ClCompile Include="src\Products\Community\PhantomHome\UI\Tray\TrayIpc.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\Products\Community\PhantomHome\UI\Tray\TrayApp.hpp" />
    <ClInclude Include="src\Products\Community\PhantomHome\UI\Tray\TrayIconIds.hpp" />
    <ClInclude Include="src\Products\Community\PhantomHome\UI\Tray\TrayMenu.hpp" />
    <ClInclude Include="src\Products\Community\PhantomHome\UI\Tray\AutoRun.hpp" />
    <ClInclude Include="src\Products\Community\PhantomHome\UI\Tray\InstallProbe.hpp" />
    <ClInclude Include="src\Products\Community\PhantomHome\UI\Tray\Version.hpp" />
    <ClInclude Include="src\Products\Community\PhantomHome\UI\Tray\TrayIpc.hpp" />
    <ClInclude Include="src\Products\Community\PhantomHome\UI\Shared\TrayUiArgs.hpp" />
  </ItemGroup>
  <!-- Engine dependency (only Logger symbols pulled by linker) -->
  <ItemGroup>
    <ProjectReference Include="PhantomCoreLib.vcxproj">
      <Project>{8A5C6B4D-2E1F-4A3B-9C7D-0E1F2A3B4C5D}</Project>
    </ProjectReference>
  </ItemGroup>

  <!-- tray.rc: embeds the ShadowStrike brand icon into the tray executable.
       All 5 state icon IDs currently resolve to the same multi-resolution
       ShadowStrike.ico master; per-state tinting (healthy/atrisk/critical/
       paused/offline) is a future polish task once a design pass has
       produced state-specific overlays.  The runtime still honours
       IconResourceForState() so the wiring is forward-compatible. -->
  <ItemGroup>
    <ResourceCompile Include="src\Products\Community\PhantomHome\UI\Tray\tray.rc" />
    <!-- Separate from tray.rc, which is excluded from the build until the .ico
         files exist. Keeping the version block out of that file means the binary
         is versioned regardless of the artwork. -->
    <ResourceCompile Include="src\Products\Community\PhantomHome\UI\Tray\tray_version.rc" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
