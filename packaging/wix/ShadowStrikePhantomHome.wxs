<?xml version="1.0" encoding="utf-8"?>
<!--
   ShadowStrike Phantom Home - WiX v4 MSI authoring.

   Build:
     wix build -arch x64 -d ProductVersion=1.0.0 -d BinDir=bin\Release ^
       -ext WixToolset.Util.wixext ^
       packaging\wix\ShadowStrikePhantomHome.wxs ^
       -o bin\Release\ShadowStrikePhantomHome.msi

   Notes:
     * The MSI installs the service via MSI's native ServiceInstall element
       rather than invoking a separate install flag. This gives the MSI engine
       full control over rollback and uninstall so half-installed states
       are impossible.
     * The tray is registered in the machine-wide Run key at install time
       so it launches for every interactive user on logon.
     * UpgradeCode must remain stable across all future releases; changing
       it would break the upgrade path for every existing customer.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="ShadowStrike Phantom Home"
           Manufacturer="ShadowStrike-Labs"
           Version="$(var.ProductVersion)"
           UpgradeCode="D8A6D9E2-4E2F-4A8B-9D3E-7F6B0E2C1A11"
           InstallerVersion="500"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <Property Id="ARPHELPLINK"     Value="https://shadowstrike.dev/support" />
    <Property Id="ARPURLINFOABOUT" Value="https://shadowstrike.dev" />
    <Property Id="ARPNOREPAIR"     Value="1" />
    <Property Id="ARPNOMODIFY"     Value="1" />

    <Launch Condition="Installed OR (VersionNT64 &gt;= 603)"
            Message="ShadowStrike Phantom Home requires 64-bit Windows 10 or later." />
    <Launch Condition="Installed OR Privileged"
            Message="ShadowStrike Phantom Home must be installed with administrator privileges." />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainFeature"
             Title="ShadowStrike Phantom Home"
             Level="1"
             ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="ServiceExecutable" />
      <ComponentRef Id="TrayExecutable"    />
      <ComponentRef Id="UIExecutable"      />
      <ComponentRef Id="QtCoreRuntime"     />
      <ComponentRef Id="QtStyleRuntime"    />
      <ComponentRef Id="VendorRuntime"     />
      <ComponentRef Id="QtPlatforms"       />
      <ComponentRef Id="QtImageFormats"    />
      <ComponentRef Id="QtIconEngines"     />
      <ComponentRef Id="TrayAutostart"     />
      <ComponentRef Id="PhantomSensorDriver" />
      <ComponentRef Id="OnnxRuntime" />
      <ComponentRef Id="CortexModelRegistry" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="CompanyFolder" Name="ShadowStrike">
        <Directory Id="INSTALLFOLDER" Name="Phantom">
          <Directory Id="PlatformsDir"    Name="platforms" />
          <Directory Id="ImageFormatsDir" Name="imageformats" />
          <Directory Id="IconEnginesDir"  Name="iconengines" />
          <Directory Id="DriversDir"      Name="Drivers" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- World-readable ProgramData model store for PhantomCortex ONNX models. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="CortexCompanyDataFolder" Name="ShadowStrike">
        <Directory Id="CortexModelsFolder" Name="Models" />
      </Directory>
    </StandardDirectory>

    <Component Id="ServiceExecutable"
               Directory="INSTALLFOLDER"
               Guid="8A1B0C7E-4F3A-4D1E-AC2D-9F6E2A1B3C41"
               Bitness="always64">
      <File Id="ServiceExe"
            Name="ShadowStrikePhantomService.exe"
            Source="$(var.BinDir)\ShadowStrikePhantomService.exe"
            KeyPath="yes" />

      <ServiceInstall Id="SvcInstall"
                      Name="ShadowStrikePhantomService"
                      DisplayName="ShadowStrike Phantom Service"
                      Description="Provides ShadowStrike Phantom Home real-time protection, scanning, and telemetry."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Vital="yes"
                      Account="LocalSystem">
        <util:ServiceConfig FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="none"
                            RestartServiceDelayInSeconds="60"
                            ResetPeriodInDays="1" />
      </ServiceInstall>

      <!-- Do not use MSI StartServices; DriverResume owns post-install startup
           after driver/runtime staging and writes explicit diagnostics. -->
      <ServiceControl Id="SvcStartStop"
                      Name="ShadowStrikePhantomService"
                      Stop="both"
                      Remove="uninstall" />
    </Component>

    <Component Id="TrayExecutable"
               Directory="INSTALLFOLDER"
               Guid="71C7E2F4-2E9A-4B1D-8D5A-5A0F6C3E2D22"
               Bitness="always64">
      <File Id="TrayExe"
            Name="ShadowStrikePhantomTray.exe"
            Source="$(var.BinDir)\ShadowStrikePhantomTray.exe"
            KeyPath="yes" />
    </Component>

    <Component Id="UIExecutable"
               Directory="INSTALLFOLDER"
               Guid="B3F4A5E6-7C8D-4E9F-A0B1-2C3D4E5F6071"
               Bitness="always64">
      <File Id="UIExe"
            Name="ShadowStrikePhantomUI.exe"
            Source="$(var.BinDir)\ShadowStrikePhantomUI.exe"
            KeyPath="yes" />
    </Component>

    <!-- Qt6 core runtime DLLs (harvested by windeployqt) -->
    <Component Id="QtCoreRuntime"
               Directory="INSTALLFOLDER"
               Guid="A1B2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C51"
               Bitness="always64">
      <File Id="Qt6Core"         Name="Qt6Core$(var.QtSuffix).dll"         Source="$(var.BinDir)\Qt6Core$(var.QtSuffix).dll"         KeyPath="yes" />
      <File Id="Qt6Gui"          Name="Qt6Gui$(var.QtSuffix).dll"          Source="$(var.BinDir)\Qt6Gui$(var.QtSuffix).dll" />
      <File Id="Qt6Network"      Name="Qt6Network$(var.QtSuffix).dll"      Source="$(var.BinDir)\Qt6Network$(var.QtSuffix).dll" />
      <File Id="Qt6Qml"          Name="Qt6Qml$(var.QtSuffix).dll"          Source="$(var.BinDir)\Qt6Qml$(var.QtSuffix).dll" />
      <File Id="Qt6QmlModels"    Name="Qt6QmlModels$(var.QtSuffix).dll"    Source="$(var.BinDir)\Qt6QmlModels$(var.QtSuffix).dll" />
      <File Id="Qt6Quick"        Name="Qt6Quick$(var.QtSuffix).dll"        Source="$(var.BinDir)\Qt6Quick$(var.QtSuffix).dll" />
      <File Id="Qt6QuickCtrl2"   Name="Qt6QuickControls2$(var.QtSuffix).dll" Source="$(var.BinDir)\Qt6QuickControls2$(var.QtSuffix).dll" />
      <File Id="Qt6QuickCtrl2Impl" Name="Qt6QuickControls2Impl$(var.QtSuffix).dll" Source="$(var.BinDir)\Qt6QuickControls2Impl$(var.QtSuffix).dll" />
      <File Id="Qt6QuickLayouts" Name="Qt6QuickLayouts$(var.QtSuffix).dll" Source="$(var.BinDir)\Qt6QuickLayouts$(var.QtSuffix).dll" />
      <File Id="Qt6QuickTemplates2" Name="Qt6QuickTemplates2$(var.QtSuffix).dll" Source="$(var.BinDir)\Qt6QuickTemplates2$(var.QtSuffix).dll" />
      <File Id="Qt6Svg"          Name="Qt6Svg$(var.QtSuffix).dll"          Source="$(var.BinDir)\Qt6Svg$(var.QtSuffix).dll" />
      <File Id="Qt6OpenGL"       Name="Qt6OpenGL$(var.QtSuffix).dll"       Source="$(var.BinDir)\Qt6OpenGL$(var.QtSuffix).dll" />
    </Component>

    <!-- Qt6 QuickControls2 style DLLs -->
    <Component Id="QtStyleRuntime"
               Directory="INSTALLFOLDER"
               Guid="A1B2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C52"
               Bitness="always64">
      <File Id="Qt6QC2Basic"        Name="Qt6QuickControls2Basic$(var.QtSuffix).dll"        Source="$(var.BinDir)\Qt6QuickControls2Basic$(var.QtSuffix).dll" KeyPath="yes" />
      <File Id="Qt6QC2BasicImpl"    Name="Qt6QuickControls2BasicStyleImpl$(var.QtSuffix).dll" Source="$(var.BinDir)\Qt6QuickControls2BasicStyleImpl$(var.QtSuffix).dll" />
      <File Id="Qt6QC2Fusion"       Name="Qt6QuickControls2Fusion$(var.QtSuffix).dll"       Source="$(var.BinDir)\Qt6QuickControls2Fusion$(var.QtSuffix).dll" />
      <File Id="Qt6QC2FusionImpl"   Name="Qt6QuickControls2FusionStyleImpl$(var.QtSuffix).dll" Source="$(var.BinDir)\Qt6QuickControls2FusionStyleImpl$(var.QtSuffix).dll" />
      <File Id="Qt6QC2Imagine"      Name="Qt6QuickControls2Imagine$(var.QtSuffix).dll"      Source="$(var.BinDir)\Qt6QuickControls2Imagine$(var.QtSuffix).dll" />
      <File Id="Qt6QC2ImagineImpl"  Name="Qt6QuickControls2ImagineStyleImpl$(var.QtSuffix).dll" Source="$(var.BinDir)\Qt6QuickControls2ImagineStyleImpl$(var.QtSuffix).dll" />
      <File Id="Qt6QC2Material"     Name="Qt6QuickControls2Material$(var.QtSuffix).dll"     Source="$(var.BinDir)\Qt6QuickControls2Material$(var.QtSuffix).dll" />
      <File Id="Qt6QC2MaterialImpl" Name="Qt6QuickControls2MaterialStyleImpl$(var.QtSuffix).dll" Source="$(var.BinDir)\Qt6QuickControls2MaterialStyleImpl$(var.QtSuffix).dll" />
      <File Id="Qt6QC2Universal"    Name="Qt6QuickControls2Universal$(var.QtSuffix).dll"    Source="$(var.BinDir)\Qt6QuickControls2Universal$(var.QtSuffix).dll" />
      <File Id="Qt6QC2UniversalImpl" Name="Qt6QuickControls2UniversalStyleImpl$(var.QtSuffix).dll" Source="$(var.BinDir)\Qt6QuickControls2UniversalStyleImpl$(var.QtSuffix).dll" />
      <File Id="Qt6QC2WinImpl"      Name="Qt6QuickControls2WindowsStyleImpl$(var.QtSuffix).dll" Source="$(var.BinDir)\Qt6QuickControls2WindowsStyleImpl$(var.QtSuffix).dll" />
      <File Id="Qt6QuickShapes"     Name="Qt6QuickShapes$(var.QtSuffix).dll" Source="$(var.BinDir)\Qt6QuickShapes$(var.QtSuffix).dll" />
      <File Id="Qt6QmlWorkerScript" Name="Qt6QmlWorkerScript$(var.QtSuffix).dll" Source="$(var.BinDir)\Qt6QmlWorkerScript$(var.QtSuffix).dll" />
    </Component>

    <!-- Vendor runtime DLLs (OpenSSL) -->
    <Component Id="VendorRuntime"
               Directory="INSTALLFOLDER"
               Guid="A1B2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C53"
               Bitness="always64">
      <File Id="libcrypto" Name="libcrypto-3-x64.dll" Source="$(var.BinDir)\libcrypto-3-x64.dll" KeyPath="yes" />
      <File Id="libssl"    Name="libssl-3-x64.dll"    Source="$(var.BinDir)\libssl-3-x64.dll" />
    </Component>

    <!-- ONNX Runtime (PhantomCortex inference engine) -->
    <Component Id="OnnxRuntime"
               Directory="INSTALLFOLDER"
               Guid="C4A1B2D3-5E6F-4708-9A1B-2C3D4E5F60A1"
               Bitness="always64">
      <File Id="OrtDll"
            Name="onnxruntime.dll"
            Source="$(var.BinDir)\onnxruntime.dll"
            KeyPath="yes" />
      <File Id="OrtProvidersSharedDll"
            Name="onnxruntime_providers_shared.dll"
            Source="$(var.BinDir)\onnxruntime_providers_shared.dll" />
    </Component>

    <!-- Registry pointer so the service can locate the model store without
         a full CortexConfig.json deployment. -->
    <Component Id="CortexModelRegistry"
               Directory="CortexModelsFolder"
               Guid="C4A1B2D3-5E6F-4708-9A1B-2C3D4E5F60A2"
               Bitness="always64">
      <CreateFolder />
      <RegistryKey Root="HKLM" Key="SOFTWARE\ShadowStrike\PhantomCortex">
        <RegistryValue Name="ModelDirectory"
                       Type="string"
                       Value="[CommonAppDataFolder]ShadowStrike\Models"
                       KeyPath="yes" />
      </RegistryKey>
    </Component>

    <!-- Qt plugin: platforms -->
    <Component Id="QtPlatforms"
               Directory="PlatformsDir"
               Guid="A1B2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C54"
               Bitness="always64">
      <File Id="qwindows" Name="qwindows$(var.QtSuffix).dll" Source="$(var.BinDir)\platforms\qwindows$(var.QtSuffix).dll" KeyPath="yes" />
    </Component>

    <!-- Qt plugin: imageformats -->
    <Component Id="QtImageFormats"
               Directory="ImageFormatsDir"
               Guid="A1B2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C55"
               Bitness="always64">
      <File Id="qsvg" Name="qsvg$(var.QtSuffix).dll" Source="$(var.BinDir)\imageformats\qsvg$(var.QtSuffix).dll" KeyPath="yes" />
    </Component>

    <!-- Qt plugin: iconengines -->
    <Component Id="QtIconEngines"
               Directory="IconEnginesDir"
               Guid="A1B2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C56"
               Bitness="always64">
      <File Id="qsvgicon" Name="qsvgicon$(var.QtSuffix).dll" Source="$(var.BinDir)\iconengines\qsvgicon$(var.QtSuffix).dll" KeyPath="yes" />
    </Component>

    <Component Id="TrayAutostart"
               Directory="INSTALLFOLDER"
               Guid="C4D5E6F7-8091-4A2B-B3C4-5D6E7F809102"
               Bitness="always64">
      <RegistryValue Root="HKLM"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="ShadowStrikePhantomTray"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]ShadowStrikePhantomTray.exe&quot;"
                     KeyPath="yes" />
    </Component>

    <!--
         PhantomSensor minifilter driver payload.

         The MSI stages the driver files on disk but does NOT auto-install the
         minifilter. Loading a kernel driver is a deliberate act that requires
         either a production WHQL signature or `bcdedit /set testsigning on` on
         the target host. The deployment runbook documents the manual
         `pnputil /add-driver ... /install` + `fltmc load` step.
    -->
    <Component Id="PhantomSensorDriver"
               Directory="DriversDir"
               Guid="D5E6F708-9112-4B3C-C4D5-6E7F80912233"
               Bitness="always64">
      <File Id="PhantomSensorSys"
            Name="PhantomSensor.sys"
            Source="$(var.SensorDir)\PhantomSensor.sys"
            KeyPath="yes" />
      <File Id="PhantomSensorInf"
            Name="PhantomSensor.inf"
            Source="$(var.SensorDir)\PhantomSensor\PhantomSensor.inf" />
      <File Id="PhantomSensorCat"
            Name="phantomsensor.cat"
            Source="$(var.SensorDir)\PhantomSensor\phantomsensor.cat" />
      <File Id="PhantomSensorCer"
            Name="PhantomSensor.cer"
            Source="$(var.SensorDir)\PhantomSensor.cer" />
    </Component>

  </Package>
</Wix>
