<?xml version="1.0" encoding="UTF-8"?>
<!--
  ShadowStrike Phantom Home – Burn bootstrapper bundle.

  Bundle UpgradeCode: {CCD11E3C-E8D9-461C-A8CC-BEE40AF19402}
  IMMUTABLE across all future bootstrapper releases.

  Product/bundle version: 1.0.2.0
    1.0.2.0 introduces the shipped trust-root certificate component
    (CmpShadowStrikeRootCert) and the ExecInstallRootCert custom action that
    imports it into LocalMachine\Root before the driver stage1 work runs.

  Post-install behavior note (bootstrapper side, documentation only):
    After the chained MSI completes, the bootstrapper reads
      %ProgramData%\ShadowStrike\State\driver-stage1.json
    to determine whether a reboot is required ("reboot_required": true|false)
    and surface the user-visible restart prompt.  The actual JSON-reading
    bootstrapper code lives outside this file; this comment exists so future
    maintainers do not break the contract by renaming the state file or
    moving its location.  The plain `<ScheduleReboot>` from MSI also bubbles
    up via `bal:WixStandardBootstrapperApplication` by default, which is the
    fallback path when the JSON is missing or malformed.

  Chain (in order):
    1. vc_redist.x64.exe  – Microsoft Visual C++ Redistributable (x64)
    2. ShadowStrikePhantom-Home-Setup.msi – the product MSI

  Build (from repo root):
    wix build -arch x64 ^
      -d ProductVersion=1.0.10.0 ^
      -d BinDir=bin\Release ^
      -d InstallerDir=packaging\installer ^
      -d MsiPath=build\installer\ShadowStrikePhantom-Home-Setup.msi ^
      -ext WixToolset.BootstrapperApplications.wixext ^
      -ext WixToolset.Util.wixext ^
      packaging\installer\Bundle.wxs ^
      -o build\installer\ShadowStrikePhantom-Home-Setup.exe
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Bundle Name="ShadowStrike Phantom Home"
          Manufacturer="ShadowStrike-Labs"
          Version="$(var.ProductVersion)"
          UpgradeCode="{CCD11E3C-E8D9-461C-A8CC-BEE40AF19402}"
          IconSourceFile="$(var.InstallerDir)\icons\ShadowStrike.ico"
          AboutUrl="https://shadowstrike.dev">

    <!--
      WixStandardBootstrapperApplication with the rtfLicense theme displays a
      full-page licence agreement before the user can proceed with installation.
      The EULA text (RTF) is also embedded in the MSI's WixUI_Minimal dialog;
      including it here means the user sees it regardless of how the bundle
      is invoked.

      ShowVersion="yes"      – display the product version in the bundle UI.
      The chained MSI schedules a reboot when Stage 1 enables testsigning, so
      Burn can surface the restart requirement without MSI rollback.
    -->
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          Theme="rtfLicense"
          LicenseFile="$(var.InstallerDir)\License.rtf"
          LogoFile="$(var.InstallerDir)\icons\ShadowStrike.ico"
          SuppressOptionsUI="yes"
          SuppressRepair="yes"
          ShowVersion="yes"/>
    </BootstrapperApplication>

    <Chain>

      <!--
        VC++ Redistributable – must install before the MSI because
        ShadowStrikePhantomService.exe links the MSVC 2022 runtime.

        Permanent="yes" prevents uninstall: VC++ may be shared by other
        applications and must not be removed with this product.

        DetectCondition: the VC 2022 x64 installer sets Installed=1
        under HKLM\SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64.
      -->
      <ExePackage Id="VcRedist"
                  DisplayName="Microsoft Visual C++ 2015-2022 Redistributable (x64)"
                  Description="Visual C++ runtime required by ShadowStrike Phantom components."
                  SourceFile="$(var.BinDir)\vc_redist.x64.exe"
                  InstallArguments="/install /quiet /norestart"
                  RepairArguments="/repair /quiet /norestart"
                  UninstallArguments="/uninstall /quiet /norestart"
                  DetectCondition="VcRedistInstalled"
                  Permanent="yes"
                  Vital="yes"/>

      <!--
        Product MSI – installed after the VC++ runtime is confirmed present.
        ForcePerMachine ensures the MSI cannot be deployed per-user even if
        the current user lacks elevation.
      -->
      <MsiPackage Id="PhantomHomeMsi"
                  DisplayName="ShadowStrike Phantom Home"
                  Description="Installs the ShadowStrike Phantom Home NGAV platform."
                  SourceFile="$(var.MsiPath)"
                  ForcePerMachine="yes"
                  Vital="yes"/>

    </Chain>

  </Bundle>

  <!--
    Registry search: populate VcRedistInstalled so the ExePackage's
    DetectCondition can skip VC++ if it is already present.
  -->
  <Fragment>
    <util:RegistrySearch Id="VcRedistSearch"
                         Root="HKLM"
                         Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
                         Value="Installed"
                         Variable="VcRedistInstalled"
                         Result="value"/>
  </Fragment>

  <!--
    Registry search: driver installation complete flag.
    Written by ShadowStrikeDriverResume.exe (stage2 mode) on successful driver load.
    Used by the bundle to determine whether the driver has already been installed
    (idempotency guard; the DriverResume EXE is also internally idempotent,
    so the bundle condition is informational / UI polish only).
  -->
  <Fragment>
    <util:RegistrySearch Id="DriverCompleteSearch"
                         Root="HKLM"
                         Key="SOFTWARE\ShadowStrike\PhantomHome\Driver"
                         Value="InstallComplete"
                         Variable="DriverInstallComplete"
                         Result="value"/>
  </Fragment>

</Wix>
