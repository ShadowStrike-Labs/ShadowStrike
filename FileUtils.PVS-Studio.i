                    return std::wstring();
                }

                
                if (need > MAX_REASONABLE_PATH_LENGTH) {
                    if (err) {
                        err->win32 = 111L;
                        err->message = "Resolved path would exceed maximum length";
                    }
                    return std::wstring();
                }

                std::wstring full;
                try {
                    full.resize(need);
                }
                catch (const std::bad_alloc&) {
                    if (err) err->win32 = 8L;
                    return std::wstring();
                }

                const DWORD got = GetFullPathNameW(input.c_str(), need, &full[0], nullptr);
                if (got == 0) {
                    if (err) err->win32 = GetLastError();
                    return std::wstring();
                }

                
                while (!full.empty() && full.back() == L'\0') {
                    full.pop_back();
                }

                
                if (!resolveFinal) {
                    return full;
                }

                
                const std::wstring longp = AddLongPathPrefix(full);
                HANDLE h = CreateFileW(
                    longp.c_str(),
                    ( 0x0080 ),
                    0x00000001 | 0x00000002 | 0x00000004,
                    nullptr,
                    3,
                    0x02000000,  
                    nullptr
                );

                if (h == ((HANDLE)(LONG_PTR)-1)) {
