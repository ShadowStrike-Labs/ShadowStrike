                    if (err) err->win32 = 8L;
                    do { auto& _lg = ::ShadowStrike::Utils::Logger::Instance(); if (_lg.IsInitialized() && _lg.IsEnabled(::ShadowStrike::Utils::LogLevel::Error)) { _lg.LogEx(::ShadowStrike::Utils::LogLevel::Error, (L"FileUtils"), ::ShadowStrike::Utils::Logger::NarrowToWideTLS("C:\\ShadowStrike\\ShadowStrike\\src\\utils\\FileUtils.cpp"), 444, ::ShadowStrike::Utils::Logger::NarrowToWideTLS( __FUNCTION__  ), (L"Memory allocation failed for size: %llu"),fileSize); } } while(0);
                    return false;
