        explanation = Describe(matcher);
      }
      if (all_match_result.empty()) {
        all_match_result = explanation;
      } else {
        if (!explanation.empty()) {
          all_match_result += ", and ";
          all_match_result += explanation;
        }
      }
    }

    *listener << all_match_result;
    return true;
  }

