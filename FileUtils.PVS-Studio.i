    if (!listener->IsInterested()) {
      
      for (const Matcher<T>& matcher : matchers_) {
        if (!matcher.Matches(x)) {
          return false;
        }
      }
      return true;
    }
    
    
    
    std::string all_match_result;
    for (const Matcher<T>& matcher : matchers_) {
      StringMatchResultListener slistener;
      
      if (!matcher.MatchAndExplain(x, &slistener)) {
