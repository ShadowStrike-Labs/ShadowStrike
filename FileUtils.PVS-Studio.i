                    return false;
                }

                
                Error dirErr{};
                if (!IsDirectory(dir, &dirErr)) {
                    
                    
                    if (Exists(dir, nullptr)) {
                        if (err) {
                            err->win32 = 267L;
                            err->message = "Path is not a directory";
                        }
                        return false;
                    }
                    return true;  
                }

                return RemoveDirectoryRecursiveImpl(ToW(dir), err);
            }

		}  

	}  
}  
