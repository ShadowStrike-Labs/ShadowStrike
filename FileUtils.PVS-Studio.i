                    internal::negation<std::is_same<
                        OnceAction, typename std::decay<Callable>::type>>,
                    
                    
                    internal::negation<IsDirectlyCompatible<Callable>>,
                    IsCompatibleAfterIgnoringArguments<Callable>>::value,
