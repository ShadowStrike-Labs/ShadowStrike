<?xml version="1.0" encoding="utf-8"?>
<!--
  PhantomTests.vcxproj
  ====================
  The test runner this repository has never had.

  There are roughly 5,960 GoogleTest cases across 131,420 lines under tests\,
  written against real interfaces with real assertions - and until this project
  existed not one of them could be built, let alone executed. There was no test
  project in the solution, no CMake, and no runner script. The only automated
  test execution in the entire repository was 22 Python methods in
  tests\kernel_contracts, which check source-level invariants of five sensor
  files without loading the driver.

  That is why defects have been found by reading logs on a virtual machine
  instead of by a test failing on a build machine, and why four modules could
  sit silently inert for months.

  Deliberately incremental. Test sources are enabled a directory at a time
  rather than all at once, because 131,420 lines of never-compiled code will not
  compile on the first attempt and a wall of thousands of errors is not
  actionable. The order below follows the open problem list: the communication
  pipeline first, because the last unknown in the freeze chain is why kernel
  frames fail validation, and those 156 cases exercise exactly that framing.

  gtest and gmock are already vendored under vendor\gtest_framework, so nothing
  new is introduced here - the dependency was paid for long ago and never used.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{3D7E5A18-9C42-4B60-8E11-7F2A6D9C4E85}</ProjectGuid>
    <RootNamespace>PhantomTests</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <IntDir>$(ProjectDir)build\$(Configuration)\Tests\</IntDir>
    <OutDir>$(SolutionDir)bin\$(Configuration)\</OutDir>
    <TargetName>phantom-tests</TargetName>
    <!-- MSB8027 IS AN ERROR HERE, DELIBERATELY.
         MSB8027 fires when two source files share a basename and therefore write
         the same .obj into $(IntDir). The linker then reports LNK4042 (object
         specified more than once, extras ignored) and silently keeps one. Every
         test case in the losing translation unit disappears from
         phantom-tests.exe while the build reports success and the suite reports a
         healthy pass count - the exact silent-success shape this project keeps
         paying for.
         It happened: tests\unit\selfprotection_unit and tests\unit\realtime_unit
         both contain MemoryProtection_Tests.cpp, and four MemoryProtectionTests
         cases were absent from the binary for as long as both were enabled.
         the gtest test lister listed nothing for them.
         Fixed by giving each an explicit ObjectFileName, but a per-file fix only
         covers the collisions that exist today and this project gains test
         directories continuously. As an error, the NEXT one stops the build and
         names both files instead of quietly deleting a suite.
         Same reasoning as VerifyTestFixtureUniqueness below: googletest cannot
         detect a duplicate fixture name either, so the build has to. -->
    <MSBuildWarningsAsErrors>$(MSBuildWarningsAsErrors);MSB8027</MSBuildWarningsAsErrors>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Must match PhantomCoreLib (stdcpp23). At stdcpp20 this project could not
           include Utils/Logger.hpp at all: it uses std::format_string, which MSVC
           only exposes in C++23 mode, so every header chain reaching the logger
           failed with "'format_string': is not a member of 'std'". Since almost
           every module logs, that made most of the codebase unincludable from a
           test - a plausible reason this project compiled 2 of the 207 test files
           present in tests\. A test project on an older standard than the code it
           tests cannot test that code. -->
      <LanguageStandard>stdcpp23</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalOptions>/Zc:__cplusplus /bigobj %(AdditionalOptions)</AdditionalOptions>
      <ExceptionHandling>Sync</ExceptionHandling>
      <WarningLevel>Level3</WarningLevel>
      <!-- Tests are not held to /WX: a warning in a test is not a product defect
           and turning them into errors would stall the effort to get the suite
           running at all. Product code keeps its stricter setting. -->
      <TreatWarningAsError>false</TreatWarningAsError>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- Test sources include product headers as "src/PhantomCore/..." from the
           repository root, so the root itself must be on the include path.
           include\YARA is needed because YaraRuleStore.hpp includes <yara.h>
           directly when SHADOWSTRIKE_HAS_YARA is defined, which it now is. -->
      <AdditionalIncludeDirectories>
        $(ProjectDir);
        $(ProjectDir)include;
        $(ProjectDir)include\YARA;
        $(ProjectDir)src;
        $(ProjectDir)src\PhantomCore;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>
        WIN32;_WINDOWS;UNICODE;_UNICODE;NOMINMAX;WIN32_LEAN_AND_MEAN;
        SHADOWSTRIKE_PRODUCT_HOME=1;
        SHADOWSTRIKE_TESTING=1;
        SHADOWSTRIKE_DIAG_TRACE=0;
        SHADOWSTRIKE_HAS_YARA;
        <!-- gtest.lib and gmock.lib in vendor\gtest_framework are IMPORT libraries for
           gtest.dll and gmock.dll, not static libraries. googletest requires a
           consumer of the shared build to say so, because these macros are what put
           __declspec(dllimport) on EXPORTED DATA. Function calls resolve through the
           import thunks either way, which is why 2,000+ tests linked without them -
           the first thing to fail was testing::internal::g_gmock_mutex, a data
           symbol, reached only by the one file that uses EXPECT_CALL.
           Every other project in this solution already defines both. The test
           project not doing so was the same class of divergence as it missing
           SHADOWSTRIKE_HAS_YARA: the project that consumes a dependency held a
           different view of it than everything else. -->
      GTEST_LINKED_AS_SHARED_LIBRARY=1;
      GMOCK_LINKED_AS_SHARED_LIBRARY=1;
      GTEST_HAS_PTHREAD=0;%(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>
        $(SolutionDir)lib\$(Configuration);
        $(SolutionDir)vendor\gtest_framework;
        $(SolutionDir)vendor\openssl_lib;
        $(SolutionDir)vendor\yara_lib;
        $(SolutionDir)vendor\onnxruntime\lib;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <!-- PhantomCoreLib is built with SHADOWSTRIKE_HAS_ONNXRUNTIME=1, so any test
           that reaches ScanEngine pulls in the Cortex inference objects and needs
           OrtGetApiBase resolved. Matches the service's link inputs. -->
      <AdditionalDependencies>
        PhantomCoreLib.lib;gtest.lib;gmock.lib;
        libyara.lib;libcrypto.lib;libssl.lib;
        onnxruntime.lib;
        advapi32.lib;kernel32.lib;user32.lib;shell32.lib;ole32.lib;oleaut32.lib;
        crypt32.lib;wintrust.lib;version.lib;ws2_32.lib;wbemuuid.lib;
        iphlpapi.lib;psapi.lib;shlwapi.lib;bcrypt.lib;ncrypt.lib;userenv.lib;
        wtsapi32.lib;normaliz.lib;winhttp.lib;fltlib.lib;rpcrt4.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- The runner entry point. -->
    <ClCompile Include="tests\test_main.cpp" />
    <!-- Enabled suite 1: kernel/user framing. 156 cases. Chosen first because
         task 22 - why kernel frames fail validation - is the last unknown in
         the freeze chain, and this is the code that would prove it. -->
    <ClCompile Include="tests\integration\communication_pipeline\CommunicationPipeline_Integration_Tests.cpp" />
    <!-- Enabled suite 2: self-exclusion. Asserts that the engine has ACTUALLY
         registered its own data files as exclusions, not merely that the list
         would be correct if anyone populated it. Four exclusion mechanisms
         existed in this product with zero production callers between them, so
         the wiring is the part worth testing. -->
    <ClCompile Include="tests\unit\self_exclusion\SelfExclusion_Tests.cpp" />
    <!-- Enabled suite 3: threat-level mapping. The level decides conviction vs
         indicator, so an error here is a detection defect in either direction.
         Guards the 0-5 severity ordinal against the 0-100 score scale, which
         would silently invert severities at the low end. -->
    <ClCompile Include="tests\unit\threat_level\ThreatLevelMapping_Tests.cpp" />
    <!-- Enabled suite 4: masked pattern matching. A masked matcher can fail in two
         opposite directions - miss content it describes, or match content it does
         not - so every positive case here is paired with a negative one. The
         OverShift cases specifically guard Boyer-Moore's skip tables, which are
         fast because they jump over positions proven impossible; built without
         consulting the mask they jump over valid matches instead, giving a matcher
         that is correct on most inputs and silently blind on the rest. -->
    <ClCompile Include="tests\unit\masked_patterns\MaskedPattern_Tests.cpp" />
    <!-- Enabled suite 5: compiled-pattern size limits. Five constants used to govern
         one value independently and the smallest of them - an undocumented 256 inside
         PatternStore.cpp - decided what actually worked, while the builder advertised
         8KB. These cases assert against the governing constant rather than a literal
         and check both sides of the boundary, so moving one of the five numbers and
         not the others fails here instead of silently shrinking what a signature
         author is allowed to write. -->
    <ClCompile Include="tests\unit\pattern_limits\PatternLimits_Tests.cpp" />
    <!-- Enabled suite 6: ScanEngine teardown. The real assertion in this one is the
         PROCESS EXIT CODE, not any EXPECT: its global environment deliberately leaves
         the engine initialized after all tests run, which is the condition that used
         to fault during static destruction. Nothing inside a test can observe that -
         by then gtest has already printed PASSED - so a non-zero exit with zero
         failing tests was the only symptom. Keeping this suite means the invariant is
         checked on every run instead of rediscovered. -->
    <ClCompile Include="tests\unit\scan_engine_teardown\ScanEngineTeardown_Tests.cpp" />
    <!-- Enabled suite 7: Microsoft trust determination. The 1.0.93 field run convicted
         fourteen files and every one was a Microsoft or OneDrive binary - we attempted
         to quarantine System32\urlmon.dll five times and blocked ucrtbase.dll, and the
         endpoint survived only because the quarantine failed. The capacity report in
         that run showed trustVerdictsCached=0 across all 34 samples while the trust
         queue demonstrably drained, so IsMicrosoftSigned was answering false for every
         OS binary and each one then took the full heuristic pipeline on every access.
         These cases pin the contract that was violated and cover BOTH signing forms,
         because measurement showed the failure spans both: kernel32.dll and
         ntmarta.dll carry embedded Authenticode signatures while urlmon.dll and
         usbmon.dll carry none and are vouched for only by a security catalog. Each
         case reads the PE certificate directory to CONFIRM which form it is
         exercising, so a future Windows build cannot silently turn the catalog cases
         into duplicates of the embedded ones. Reproducing this locally is the whole
         point: the alternative is another deploy, install and reboot cycle. -->
    <ClCompile Include="tests\unit\trust_determination\TrustDetermination_Tests.cpp" />
    <!-- Pins the contract that a scan target is not a signature database.
         Three scan paths mapped their target with the DATABASE opener, which
         validates a SignatureDatabaseHeader, so no executable, archive or
         document could ever be read for scanning. Hash, pattern and YARA file
         scanning were all disabled by that one mistake. These cases use real
         files on disk because the defect lived in the interaction between the
         real Win32 mapping code and the header check; a mock reproduces
         neither. -->
    <ClCompile Include="tests\unit\scan_target_mapping\ScanTargetMapping_Tests.cpp" />
    <!-- Cloud placeholder handling. In the 1.0.94 field run eicar.com and
         eicar_com.zip were both on the user's Desktop inside OneDrive and every
         read returned WinError 395, so a known-malicious file was present and
         unexaminable while looking identical to a clean scan. The platform half
         is not our defect - a service in session 0 cannot hydrate a placeholder
         at all - but three things on top of it were: an unreadable file counted
         as clean, a doomed open attempted anyway, and a blanket reparse-point
         refusal that made EVERY file in a sync root unhashable even when its
         content was fully local. These cases pin the decisions rather than the
         platform interaction, which cannot be reproduced without a registered
         Cloud Filter provider AND a session-0 caller; the file says so at the
         top. DataVirtualisingTagsAreAllowed is the discriminator - it fails if
         the reparse check is ever simplified back to refusing everything. -->
    <ClCompile Include="tests\unit\cloud_placeholder\CloudPlaceholder_Tests.cpp" />
    <!-- Task 102. Every capacity sample in the 1.0.94 field run read "pool=0/0"
         while that same run scanned 7,213 files in 29 seconds. ScanEngine
         constructed its ThreadPool and never called Initialize(), so the pool
         held zero worker threads for the whole process life while Submit()
         still accepted work onto it - accepted, counted, never able to run.
         The startup line read "Thread pool initialized with 4 threads" because
         it printed the number of threads WANTED rather than the number the pool
         actually had. PoolReportsWorkersAfterInitialize is the discriminator:
         it asserts a NON-ZERO worker count, because the pre-fix code reported
         valid=true with a count of zero and any test checking only validity
         would have passed throughout. -->
    <ClCompile Include="tests\unit\scan_pool_health\ScanPoolHealth_Tests.cpp" />
    <!-- Pins every structure that crosses the kernel boundary, by absolute offset.
         The transport prefix name FILTER_MESSAGE_HEADER used to resolve to a
         DIFFERENT TYPE depending on include order: MessageProtocol.h aliased our
         own 40-byte application header to the name of the 16-byte OS structure
         for any translation unit that had not yet reached <fltUser.h>. Five
         subsystems parse that buffer and all compute the payload offset from
         that sizeof; two guarded the include explicitly, the rest relied on
         their include graph. The only compile-time check that existed was
         "sizeof <= 64", which 16 and 40 both satisfy.
         The application header is also declared TWICE (SHADOWSTRIKE_MESSAGE_HEADER
         and FileSystemFilter's FilterMessageHeader) and the magic constant three
         times. They agree only while every enum inside the duplicate keeps an
         explicit underlying type - drop one and every later field shifts two
         bytes in one consumer only, with no error anywhere.
         BothHeaderDeclarationsReadIdenticalBytesIdentically is the discriminator:
         it writes a distinct value per field through one declaration and reads
         them back through the other, which is the property the product relies on
         and the only one that catches two same-width neighbours swapping. -->
    <ClCompile Include="tests\unit\wire_format\WireFormat_Tests.cpp" />
    <!-- Separate translation unit, now by choice rather than by force. These
         assertions need IPCManager.hpp, and that header could not previously be
         included alongside Communication.hpp: both declare
         ShadowStrike::Communication::FileScanCallback and ::ProcessNotifyCallback,
         and before task 117 they did so with DIFFERENT types under the same names,
         so one include order gave C2371. The decoded side is now named
         ParsedFileScanCallback and siblings, the name intersection between the two
         headers is empty, and WireFormat_Tests.cpp includes BOTH headers to prove
         it. The split is kept because merging two passing suites buys nothing.
         What it pins: IPCStatistics::byMessageType was a hardcoded array of 16
         while the message-type enum ran past 40, and every counting site guards
         with "if (idx < size())" so every type from 16 upward was counted
         nowhere, and the guard is what hid it. That set was every alert class the
         driver can raise. TheOldSixteenSlotCeilingWouldHaveDroppedTheseTypes is
         the discriminator; it fails against the previous sizing. -->
    <ClCompile Include="tests\unit\wire_format\IpcStatistics_Tests.cpp" />
    <!-- RE-ENABLED together with the ownership fix that made it pass. This suite is
         what found the defect: on a first add the store kept the LOCAL compiler's
         YR_RULES singleton, so m_rules dangled as soon as the call returned, and the
         next add or namespace removal called yr_rules_destroy on it. Four cases
         faulted with SEH 0xC0000005 and ThreadSafety_ConcurrentRuleAddition killed the
         process. m_ruleSources is now the authoritative record of what the store holds
         and RebuildRulesFromSources is the only function that changes the compiled
         rules, so no path can store or free a pointer it does not own. -->
    <ClCompile Include="tests\unit\Database_systems_unit\sig_store\yara_rule_store_tests.cpp" />
